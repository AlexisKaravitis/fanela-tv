<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug only: the TV's own programme guide as a where-to-watch source (TvGuideProvider), granted by the viewer -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <application>
        <receiver android:name=".DebugReceiver" android:exported="true">
            <intent-filter>
                <action android:name="app.fanela.tv.DEMO" />
                <action android:name="app.fanela.tv.REFRESH" />
                <action android:name="app.fanela.tv.AUDIT" />
                <action android:name="app.fanela.tv.FOLLOW" />
                <action android:name="app.fanela.tv.TVGUIDE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
